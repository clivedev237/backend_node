# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=8082
APP_BASE_URL=http://localhost:8082

# ─── Base de données PostgreSQL ───────────────────────────────────────────
# IMPORTANT : c'est la MÊME instance que SPRING_DATASOURCE_URL côté Spring
# Boot Reservation (base partagée, un seul schéma "public", voir cadrage).
# Format : postgresql://utilisateur:motdepasse@host:5432/nom_base?sslmode=require
DATABASE_URL=postgresql://vora_db_user:changeme@localhost:5432/vora_db

# Mettre à "false" seulement si vous testez contre un Postgres local sans TLS.
DATABASE_SSL=true

# ─── Agrégateur Soleaspay (Orange Money / MTN MoMo) ───────────────────────
SOLEASPAY_BASE_URL=https://soleaspay.com
SOLEASPAY_BEARER_TOKEN=remplacer_par_le_vrai_token
SOLEASPAY_API_KEY=remplacer_par_la_vraie_cle
SOLEASPAY_OPERATION=PAY-IN
SOLEASPAY_SERVICE=MOBILE_MONEY

# ─── CORS (origine du frontend Vercel) ────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
